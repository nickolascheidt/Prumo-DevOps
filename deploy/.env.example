# /opt/prumo/.env on the host. Never commit the real one: it lives on the machine and in a
# password manager. See docs/RUNBOOK.md.

# Public host name. Without a domain of your own, the `sslip_domain` Terraform output.
DOMAIN=54-207-1-2.sslip.io

# From `terraform output -raw ecr_registry`.
AWS_REGION=sa-east-1
ECR_REGISTRY=123456789012.dkr.ecr.sa-east-1.amazonaws.com

# Set by deploy.sh on every deploy.
API_TAG=latest
WEB_TAG=latest

# The prumo-dev-box user's key (aws iam create-access-key --user-name prumo-dev-box).
# It can only pull these two images; the host uses it to log in to ECR.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# From scripts/aws/gen-secrets.sh.
JWT_KEY=
POSTGRES_PASSWORD=
PRUMO_APP_PASSWORD=
PRUMO_MIGRATOR_PASSWORD=

# The first sign-in, chosen by hand: at least 6 characters with a digit, a lower-case
# and an upper-case letter (the API's Identity password policy).
SEED_ADMIN_PASSWORD=
