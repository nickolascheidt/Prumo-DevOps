{$DOMAIN} {
	# Caddy obtains and renews the certificate by itself through Let's Encrypt's HTTP
	# challenge, which is why port 80 is open.

	# Caddy already sends HSTS. It does not send these on its own: they stop the SPA from
	# being framed by a third party (clickjacking), the browser from guessing content
	# types, and the full URL from leaking in the Referer.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The Angular nginx listens on 8080 (nginx/default.conf.template and the Dockerfile in
	# the Prumo-Angular repo), not 80. Pointing at 80 returned 502 for everything.
	reverse_proxy web:8080
}
